{
  "$defs": {
    "TrackRecipe": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        },
        "trim_start_seconds": {
          "default": 0,
          "maximum": 600,
          "minimum": 0,
          "title": "Trim Start Seconds",
          "type": "number"
        },
        "trim_end_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Trim End Seconds",
          "type": "number"
        },
        "gain": {
          "default": 1,
          "maximum": 4,
          "minimum": 0,
          "title": "Gain",
          "type": "number"
        },
        "loop": {
          "default": false,
          "title": "Loop",
          "type": "boolean"
        }
      },
      "required": [
        "asset_id",
        "trim_end_seconds"
      ],
      "title": "TrackRecipe",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "duration_seconds": {
      "default": 600,
      "maximum": 600,
      "minimum": 30,
      "title": "Duration Seconds",
      "type": "integer"
    },
    "tracks": {
      "items": {
        "$ref": "#/$defs/TrackRecipe"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Tracks",
      "type": "array"
    }
  },
  "required": [
    "tracks"
  ],
  "title": "MixRecipe",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
