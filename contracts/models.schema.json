{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurotune.dev/contracts/models.schema.json",
  "title": "neuroTune contracts",
  "description": "Shared contracts. Band edges are half-open: low <= f < high. Session time is monotonic seconds from session start. audio_latency_ms is the AudioTrack buffer delay, not measured ear latency.",
  "$defs": {
    "experimentConfig": {
      "type": "object",
      "required": ["version", "quality_version", "hardware_approved", "epsilon", "actions", "baseline_seconds", "block_count"],
      "properties": {
        "version": {"type": "string"},
        "quality_version": {"type": "string"},
        "hardware_approved": {"type": "boolean"},
        "epsilon": {"type": "number"},
        "actions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "opticsBatch": {
      "type": "object",
      "required": ["channel_names", "unit", "sample_rate_hz", "time_seconds", "values"],
      "properties": {
        "unit": {"const": "uA"},
        "sample_rate_hz": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "eegBatch": {
      "type": "object",
      "required": ["channel_names", "unit", "sample_rate_hz", "time_seconds", "eeg", "accel", "gyro", "contact"],
      "properties": {
        "unit": {"const": "uV"},
        "sample_rate_hz": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "featureFrame": {
      "type": "object",
      "required": ["time_seconds", "sample_rate_hz", "channels", "rejected", "reasons"],
      "properties": {
        "active_time_seconds": {"type": ["number", "null"], "minimum": 0},
        "playback_active": {"type": "boolean", "description": "Full source window has confirmed historical continuous PCM coverage; EEG quality remains independent."}
      }
    },
    "decisionEvent": {
      "type": "object",
      "required": ["session_id", "action", "selection_probability", "updated_bandit", "experiment_version", "policy_version", "aborted"]
    },
    "sessionManifest": {
      "type": "object",
      "required": ["session_id", "experiment_version", "policy_version", "data_origin", "timeline", "sample_rate_hz"],
      "properties": {
        "timeline": {"const": "monotonic_session_seconds"},
        "audio_latency_source": {"const": "audiotrack_buffer_frames"},
        "meditation": {"$ref": "#/$defs/meditationMetadata"},
        "diagnostics_version": {"type": "integer", "minimum": 0},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/sessionDiagnostic"}}
      }
    },
    "meditationMetadata": {
      "type": "object",
      "required": [
        "schema_version",
        "protocol_version",
        "mode",
        "profile_version_id",
        "fixed_action",
        "eye_state",
        "origin",
        "played_frames",
        "playback_timeline_version",
        "playback_timeline"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "protocol_version": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "fixed",
            "calibration",
            "adaptive"
          ]
        },
        "owner_account_id": {"type": "string", "format": "uuid"},
        "calibration_plan_id": {"type": "string", "format": "uuid"},
        "calibration_slot": {"type": "integer", "minimum": 0, "maximum": 9},
        "calibration_schema_version": {"const": 1},
        "profile_version_id": {
          "type": "string",
          "format": "uuid"
        },
        "fixed_action": {
          "enum": [
            "control",
            "binaural_6",
            "binaural_8",
            "binaural_10",
            "binaural_12"
          ]
        },
        "eye_state": {
          "enum": [
            "open",
            "closed"
          ]
        },
        "origin": {
          "enum": [
            "muse",
            "simulator",
            "playback"
          ]
        },
        "quality_version": {
          "type": "string"
        },
        "played_frames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 28800000
        },
        "playback_timeline_version": {
          "const": 1
        },
        "source_observed_offset_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "playback_timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "observed_seconds",
              "played_frames",
              "playback_active"
            ],
            "properties": {
              "observed_seconds": {
                "type": "number",
                "minimum": 0
              },
              "played_frames": {
                "type": "integer",
                "minimum": 0,
                "maximum": 28800000
              },
              "playback_active": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "sessionDiagnostic": {
      "type": "object",
      "required": ["time_seconds", "type", "values"],
      "properties": {
        "time_seconds": {"type": "number"},
        "type": {"type": "string"},
        "values": {"type": "object"}
      }
    },
    "banditSnapshot": {
      "type": "object",
      "required": ["policy_version", "experiment_version", "data_origin", "epsilon", "actions", "included_session_ids"]
    }
  }
}
