{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurotune.dev/contracts/audio_profile_v2.schema.json",
  "title": "Immutable sequence-derived audio profile v2; schema 1 is unchanged",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "owner_account_id",
    "profile_id",
    "version",
    "name",
    "render_snapshot",
    "background_asset_id",
    "frame_count",
    "sample_rate_hz",
    "channels",
    "sample_width_bytes",
    "checksum_sha256",
    "normalization_factor",
    "settings",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 2, "type": "integer"},
    "kind": {"const": "audio_profile"},
    "id": {"type": "string", "format": "uuid"},
    "owner_account_id": {"type": "string", "format": "uuid"},
    "profile_id": {"type": "string", "format": "uuid"},
    "version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "name": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
    "render_snapshot": {"$ref": "audio_project.schema.json#/$defs/RenderSnapshot"},
    "background_asset_id": {"type": "string", "format": "uuid"},
    "frame_count": {"type": "integer", "minimum": 1, "maximum": 172800000},
    "sample_rate_hz": {"const": 48000, "type": "integer"},
    "channels": {"const": 2, "type": "integer"},
    "sample_width_bytes": {"const": 2, "type": "integer"},
    "checksum_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "normalization_factor": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "settings": {"$ref": "audio_sequence_recipe.schema.json#/$defs/PublicationSettings"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "SessionLength": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "protocol_version",
        "profile_version_id",
        "playback_policy",
        "selection",
        "source_frame_count",
        "target_frames",
        "played_frames",
        "end_fade_frames"
      ],
      "properties": {
        "schema_version": {"const": 2, "type": "integer"},
        "protocol_version": {"const": "meditation-2"},
        "profile_version_id": {"type": "string", "format": "uuid"},
        "playback_policy": {"$ref": "audio_sequence_recipe.schema.json#/$defs/PlaybackPolicy"},
        "selection": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {"kind": {"const": "full_file"}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "minutes"],
              "properties": {"kind": {"const": "minutes"}, "minutes": {"type": "integer", "minimum": 1, "maximum": 60}}
            }
          ]
        },
        "source_frame_count": {"type": "integer", "minimum": 1, "maximum": 172800000},
        "target_frames": {"type": "integer", "minimum": 1, "maximum": 172800000},
        "played_frames": {"type": "integer", "minimum": 0, "maximum": 172800000},
        "end_fade_frames": {"type": "integer", "minimum": 1, "maximum": 240000}
      }
    }
  }
}
